<div class="plugin-button-wrapper">
    <button class="button button--primary" style="background: #3b82f6; border-color: #60a5fa; color: #fff;" @onclick="ExecutarAcaoFinanceiro">
        <span aria-hidden="true">💳</span>
        @Rotulo
    </button>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="execution-result" style="margin-top: 0.8rem; border-left-color: #3b82f6;" role="status">
            <span>@mensagem</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Rotulo { get; set; } = "Conciliar Caixa (Módulo Financeiro)";

    [Parameter]
    public EventCallback<string> OnExecutado { get; set; }

    private string? mensagem;

    private async Task ExecutarAcaoFinanceiro()
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss.fff");
        mensagem = $"[Plugin Financeiro] Conciliação bancária finalizada com sucesso às {timestamp}!";
        
        if (OnExecutado.HasDelegate)
        {
            await OnExecutado.InvokeAsync(mensagem);
        }
    }
}
